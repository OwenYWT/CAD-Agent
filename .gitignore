# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.eggs/
*.egg

# Virtual env
venv/
.venv/
env/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Environment
.env
.env.local
.env.*.local

# Data / generated files
data/
*.db

# Eval harness output (reports + rendered spot-check images). The canonical
# baseline is kept by copying it elsewhere / committing explicitly, not by tracking
# every run here. Legacy benchmark output too.
backend/benchmark/reports/
backend/benchmark_results.json

# Node
node_modules/
frontend/dist/

# The pinned CAD Skills viewer ships a prebuilt, versioned browser bundle.
# Keep the general dist/ rule above, but track this third-party runtime.
!third_party/cadskills/skills/cad-viewer/scripts/viewer/dist/
!third_party/cadskills/skills/cad-viewer/scripts/viewer/dist/**

# Test / cache
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/

# ChromaDB
chroma_data/

# .NET build artifacts (plugins)
[Bb]in/
[Oo]bj/
*.dll
*.pdb
*.baml
.gstack/

# Stray CAD output left in the CWD by 2D eval cases whose generated code
# writes a bare relative filename instead of the declared output path.
backend/output.dxf
backend/output.svg
