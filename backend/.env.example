# CAD Agent Web backend environment template
# Copy to backend/.env and replace placeholder values. Do NOT commit real API keys.

LLM_PROVIDER=azure
AZURE_OPENAI_ENDPOINT=https://<your-azure-openai-resource>.openai.azure.com/
AZURE_OPENAI_API_KEY=<AZURE_OPENAI_API_KEY>
AZURE_OPENAI_API_VERSION=2025-03-01-preview
LLM_MODEL=gpt-5
LLM_REASONING_EFFORT=minimal

# OpenAI-compatible fallback. Used only when LLM_PROVIDER=openai_compatible.
DASHSCOPE_API_KEY=<OPENAI_COMPATIBLE_API_KEY>
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

SANDBOX_RUNTIME=docker
SANDBOX_COMMAND=docker
SANDBOX_IMAGE=cad-agent-sandbox:latest
SANDBOX_TIMEOUT_S=60
SANDBOX_MEMORY_LIMIT=512m

FILE_STORAGE_DIR=./data/files
HISTORY_DB_PATH=./data/history.db
FILE_TTL_HOURS=24

# Onshape API integration. Keep keys in backend only; never place them in frontend/.env.
ONSHAPE_BASE_URL=https://cad.onshape.com
ONSHAPE_ACCESS_KEY=<ONSHAPE_ACCESS_KEY>
ONSHAPE_SECRET_KEY=<ONSHAPE_SECRET_KEY>
ONSHAPE_TIMEOUT_S=30
ONSHAPE_DEFAULT_DOCUMENT_PUBLIC=false

CORS_ORIGINS=["http://localhost:5173"]
API_KEYS=[]
AUTH_REQUIRED=true
# REQUIRED when AUTH_REQUIRED=true. The server refuses to start if this is empty
# or a placeholder. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_TOKEN_SECRET=
AUTH_TOKEN_TTL_HOURS=336
VERIFICATION_CODE_TTL_MINUTES=10
# Dev only: echo the SMS verification code back in the HTTP response (no real SMS).
# MUST stay false in production — true lets anyone obtain any phone's code.
AUTH_DEV_EXPOSE_CODE=false
# Leave empty to disable the built-in invite code. Set to seed one for local use.
DEFAULT_INVITE_CODE=
DEFAULT_INVITE_MAX_USES=100
# Leave empty to NOT auto-create the admin account. Set a STRONG password to
# provision the built-in "admin" login on next start.
ADMIN_PASSWORD=
RATE_LIMIT_PER_MINUTE=30

BUILD_VOLUME_MM=256
MIN_WALL_MM=0.8
LOG_LEVEL=info
