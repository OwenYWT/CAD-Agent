# CAD Agent Web backend environment template
# Copy to backend/.env and replace placeholder values. Do NOT commit real API keys.

APP_ENVIRONMENT=development

# One of: moonshot | openai | dashscope | azure | openai_compatible
# moonshot, openai and dashscope each supply their own default LLM_BASE_URL, so
# switching provider does not require editing the URL below. A URL left pointing
# at a different known provider is treated as stale and replaced; a custom
# gateway or proxy URL is always kept.
LLM_PROVIDER=moonshot
MOONSHOT_API_KEY=<MOONSHOT_API_KEY>
LLM_BASE_URL=https://api.moonshot.cn/v1
LLM_MODEL=kimi-k2.7-code
# Required when LLM_MODEL does not accept image inputs. Uses the same provider key.
# This model drives the visual gate: it inspects renders of the generated solid
# and rewrites the source while looking at them, so a weak vision model here
# costs accuracy directly.
VISION_MODEL=moonshot-v1-32k-vision-preview
LLM_REASONING_EFFORT=
# One model API call. Increase only after checking outbound network and provider latency.
LLM_TIMEOUT_S=60
LLM_MAX_RETRIES=1
# Planner JSON includes the design brief; reasoning-capable providers may count
# hidden reasoning against this completion budget. Too small a value truncates JSON.
PLANNER_MAX_TOKENS=8192
# Whole generation pipeline: planning + code generation + sandbox + validation.
GENERATE_DEADLINE_S=180

# Azure OpenAI alternative. Used only when LLM_PROVIDER=azure.
AZURE_OPENAI_ENDPOINT=https://<your-azure-openai-resource>.openai.azure.com/
AZURE_OPENAI_API_KEY=<AZURE_OPENAI_API_KEY>
AZURE_OPENAI_API_VERSION=2025-03-01-preview

# OpenAI. Used only when LLM_PROVIDER=openai. LLM_BASE_URL may be left at its
# Moonshot default: the OpenAI endpoint is selected automatically for this
# provider unless LLM_BASE_URL names a different host on purpose (a gateway).
OPENAI_API_KEY=<OPENAI_API_KEY>

# Alibaba DashScope (Qwen). Used when LLM_PROVIDER=dashscope, and also as the key
# for the generic LLM_PROVIDER=openai_compatible fallback, which unlike the named
# providers has no default endpoint and must set LLM_BASE_URL itself.
# Suggested DashScope pairing:  LLM_MODEL=qwen3-coder-plus  VISION_MODEL=qwen3-vl-plus
# Qwen reasoning models (qwen3.x-max) emit thousands of thinking tokens per call;
# raise LLM_TIMEOUT_S well above the default before using one.
DASHSCOPE_API_KEY=<DASHSCOPE_OR_OPENAI_COMPATIBLE_API_KEY>

# --- VLM-in-the-loop refinement (backend/app/visual_refine) ---
# Renders the generated solid with real dimensions and a section cut, measures
# it, has VISION_MODEL inspect the renders, and repairs the source with those
# renders in view. Each iteration costs one sandbox execution plus one vision
# call; the loop keeps only a candidate it can show is better, so raising the
# budget cannot make results worse, only slower.
VISUAL_REFINEMENT_ENABLED=true
VISUAL_REFINEMENT_MAX_ITERATIONS=3
# Render resolution given to the vision model. Below roughly 640 px the
# burned-in dimension text stops being legible and the measurements that make
# the gate accurate are wasted.
VISION_RENDER_PX=768
VISION_RENDER_SUPERSAMPLE=2
VISION_CRITIC_MAX_TOKENS=2048
VISION_PATCHER_MAX_TOKENS=8192

SANDBOX_RUNTIME=docker
SANDBOX_COMMAND=docker
# Local development may use a named tag. Staging/production must use
# registry/path@sha256:<digest>; application startup rejects mutable tags there.
SANDBOX_IMAGE=cad-agent-sandbox:dev
SANDBOX_TIMEOUT_S=60
SANDBOX_MEMORY_LIMIT=512m

# M1 durable control plane is the current product path. Production refuses to
# start if either flag is disabled. Never commit real credentials.
DURABLE_CONTROL_PLANE_ENABLED=true
# Atomic public write cutover: all core MCAD writes use WorkflowRun + Temporal.
DATABASE_URL=postgresql+asyncpg://cad_agent:<POSTGRES_PASSWORD>@postgres:5432/cad_agent
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DEPENDENCY_READINESS_TIMEOUT_S=5
OBJECT_STORE_ENDPOINT_URL=http://minio:9000
OBJECT_STORE_ACCESS_KEY=<MINIO_ROOT_USER>
OBJECT_STORE_SECRET_KEY=<MINIO_ROOT_PASSWORD>
OBJECT_STORE_BUCKET=cad-agent-artifacts
OBJECT_STORE_REGION=us-east-1
OBJECT_STORE_PRESIGN_TTL_S=900
ARTIFACT_UPLOAD_TTL_S=900
ARTIFACT_MAX_UPLOAD_BYTES=2147483648
ARTIFACT_ORPHAN_GRACE_S=3600
TEMPORAL_TARGET=temporal:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=cad-agent-mcad
TEMPORAL_AGENT_V2_TASK_QUEUE=cad-agent-mcad-v2
# Routing stays off until the V2 workflow passes its real release gate.

FILE_STORAGE_DIR=./data/files
HISTORY_DB_PATH=./data/history.db
FILE_TTL_HOURS=24
CAPABILITY_UPLOAD_MAX_BYTES=67108864
# Required in addition to per-action execute/confirmation flags for any Bambu LAN traffic.
CADSKILLS_ENABLE_BAMBU_LAN=false
# JSON list containing a deployment-owned isolated runner prefix. Empty blocks
# uploaded Python/JavaScript generator execution on the host.
CADSKILLS_ISOLATED_EXECUTOR=[]

# Onshape API integration. Keep keys in backend only; never place them in frontend/.env.
ONSHAPE_BASE_URL=https://cad.onshape.com
ONSHAPE_ACCESS_KEY=
ONSHAPE_SECRET_KEY=
ONSHAPE_TIMEOUT_S=30
ONSHAPE_DEFAULT_DOCUMENT_PUBLIC=false

CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]
API_KEYS=[]
AUTH_REQUIRED=true
# REQUIRED when AUTH_REQUIRED=true. The server refuses to start if this is empty
# or a placeholder. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_TOKEN_SECRET=
AUTH_TOKEN_TTL_HOURS=336
VERIFICATION_CODE_TTL_MINUTES=10
# Dev only: echo the SMS verification code back in the HTTP response (no real SMS).
# MUST stay false in production — true lets anyone obtain any phone's code.
AUTH_DEV_EXPOSE_CODE=false
# Temporarily disabled: registration is invite-only until real SMS is ready.
AUTH_CODE_FLOWS_ENABLED=false
# Required only when AUTH_CODE_FLOWS_ENABLED=true.
SMS_PROVIDER=disabled
SMS_DEFAULT_COUNTRY_CODE=+86
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
TENCENT_SMS_SDK_APP_ID=
TENCENT_SMS_SIGN_NAME=
TENCENT_SMS_TEMPLATE_ID=
TENCENT_SMS_REGION=ap-guangzhou
TENCENT_SMS_ENDPOINT=https://sms.tencentcloudapi.com
# Comma-separated template variable order. Use "code,minutes" for a template like:
# "您的验证码为{1}，{2}分钟内有效。"
TENCENT_SMS_TEMPLATE_PARAM_ORDER=code,minutes
# Alternative: send the verification payload to your own SMS gateway endpoint.
# SMS_PROVIDER=webhook
# SMS_WEBHOOK_URL=https://example.com/send-sms
# SMS_WEBHOOK_BEARER_TOKEN=
# Private-beta invite codes. Each code is single-use by default.
DEFAULT_INVITE_CODES=[]
DEFAULT_INVITE_CODE=
DEFAULT_INVITE_MAX_USES=1
# Leave empty to NOT auto-create the admin account. Set a STRONG password to
# provision the built-in "admin" login on next start.
ADMIN_PASSWORD=
RATE_LIMIT_PER_MINUTE=30

BUILD_VOLUME_MM=256
MIN_WALL_MM=0.8
LOG_LEVEL=info

# Autodesk Fusion 360 Local Runtime. Generate separate 32+ byte role secrets;
# never reuse these values and never expose the connector secret to the Backend.
FUSION_RUNTIME_URL=http://127.0.0.1:8765
FUSION_RUNTIME_BACKEND_SECRET=
# Preferred for local installs: point Backend at the mode-0600 file created by install scripts.
FUSION_RUNTIME_BACKEND_SECRET_FILE=
FUSION_RUNTIME_TIMEOUT_S=305

# Optional read-only Autodesk Platform Services integration (disabled by default).
FUSION_CLOUD_ENABLED=false
FUSION_APS_CLIENT_ID=
FUSION_APS_CLIENT_SECRET=
FUSION_APS_REDIRECT_URI=
# Fernet key generated and stored by the operator, not accepted via an API request.
FUSION_TOKEN_ENCRYPTION_KEY=
FUSION_TOKEN_DB_PATH=./data/fusion360/tokens.db

# Direct Fusion Desktop -> HTTPS Cloud Agent. The same configured LLM provider
# is used; no second model credential is required. Prompts and CAD context are
# not persisted in the audit database.
FUSION_AGENT_DB_PATH=./data/fusion360/agent-audit.db
FUSION_AGENT_ARTIFACT_DIR=./data/fusion360/agent-artifacts
FUSION_AGENT_ARTIFACT_MAX_BYTES=67108864
FUSION_AGENT_PLAN_TTL_S=300
# Empty uses LLM_MODEL.
FUSION_AGENT_MODEL=
