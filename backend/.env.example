# CAD Agent Web backend environment template
# Copy to backend/.env and replace placeholder values. Do NOT commit real API keys.

LLM_PROVIDER=moonshot
MOONSHOT_API_KEY=<MOONSHOT_API_KEY>
LLM_BASE_URL=https://api.moonshot.cn/v1
LLM_MODEL=kimi-k2.7-code
LLM_REASONING_EFFORT=
# One model API call. Increase only after checking outbound network and provider latency.
LLM_TIMEOUT_S=60
LLM_MAX_RETRIES=1
# Whole generation pipeline: planning + code generation + sandbox + validation.
GENERATE_DEADLINE_S=180

# Azure OpenAI alternative. Used only when LLM_PROVIDER=azure.
AZURE_OPENAI_ENDPOINT=https://<your-azure-openai-resource>.openai.azure.com/
AZURE_OPENAI_API_KEY=<AZURE_OPENAI_API_KEY>
AZURE_OPENAI_API_VERSION=2025-03-01-preview

# Other OpenAI-compatible fallback. Used only when LLM_PROVIDER=openai_compatible.
DASHSCOPE_API_KEY=<OPENAI_COMPATIBLE_API_KEY>

SANDBOX_RUNTIME=docker
SANDBOX_COMMAND=docker
SANDBOX_IMAGE=cad-agent-sandbox:latest
SANDBOX_TIMEOUT_S=60
SANDBOX_MEMORY_LIMIT=512m

FILE_STORAGE_DIR=./data/files
HISTORY_DB_PATH=./data/history.db
FILE_TTL_HOURS=24
CAPABILITY_UPLOAD_MAX_BYTES=67108864
# Required in addition to per-action execute/confirmation flags for any Bambu LAN traffic.
CADSKILLS_ENABLE_BAMBU_LAN=false
# JSON list containing a deployment-owned isolated runner prefix. Empty blocks
# uploaded Python/JavaScript generator execution on the host.
CADSKILLS_ISOLATED_EXECUTOR=[]

CORS_ORIGINS=["http://localhost:5173"]
API_KEYS=[]
AUTH_REQUIRED=true
# REQUIRED when AUTH_REQUIRED=true. The server refuses to start if this is empty
# or a placeholder. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_TOKEN_SECRET=
AUTH_TOKEN_TTL_HOURS=336
VERIFICATION_CODE_TTL_MINUTES=10
# Dev only: echo the SMS verification code back in the HTTP response (no real SMS).
# MUST stay false in production — true lets anyone obtain any phone's code.
AUTH_DEV_EXPOSE_CODE=false
# Temporarily disabled: registration is invite-only until real SMS is ready.
AUTH_CODE_FLOWS_ENABLED=false
# Required only when AUTH_CODE_FLOWS_ENABLED=true.
SMS_PROVIDER=disabled
SMS_DEFAULT_COUNTRY_CODE=+86
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
TENCENT_SMS_SDK_APP_ID=
TENCENT_SMS_SIGN_NAME=
TENCENT_SMS_TEMPLATE_ID=
TENCENT_SMS_REGION=ap-guangzhou
TENCENT_SMS_ENDPOINT=https://sms.tencentcloudapi.com
# Comma-separated template variable order. Use "code,minutes" for a template like:
# "您的验证码为{1}，{2}分钟内有效。"
TENCENT_SMS_TEMPLATE_PARAM_ORDER=code,minutes
# Alternative: send the verification payload to your own SMS gateway endpoint.
# SMS_PROVIDER=webhook
# SMS_WEBHOOK_URL=https://example.com/send-sms
# SMS_WEBHOOK_BEARER_TOKEN=
# Private-beta invite codes. Each code is single-use by default.
DEFAULT_INVITE_CODES=["CAD1-A7K9","CAD2-M4Q8","CAD3-Z6P2","CAD4-H9R5","CAD5-T2N7","CAD6-W8L3","CAD7-Q5X1","CAD8-B3V6","CAD9-J2Y4","CAD0-S9D8"]
DEFAULT_INVITE_CODE=
DEFAULT_INVITE_MAX_USES=1
# Leave empty to NOT auto-create the admin account. Set a STRONG password to
# provision the built-in "admin" login on next start.
ADMIN_PASSWORD=
RATE_LIMIT_PER_MINUTE=30

BUILD_VOLUME_MM=256
MIN_WALL_MM=0.8
LOG_LEVEL=info

# Autodesk Fusion 360 Local Runtime. Generate separate 32+ byte role secrets;
# never reuse these values and never expose the connector secret to the Backend.
FUSION_RUNTIME_URL=http://127.0.0.1:8765
FUSION_RUNTIME_BACKEND_SECRET=
# Preferred for local installs: point Backend at the mode-0600 file created by install scripts.
FUSION_RUNTIME_BACKEND_SECRET_FILE=
FUSION_RUNTIME_TIMEOUT_S=305

# Optional read-only Autodesk Platform Services integration (disabled by default).
FUSION_CLOUD_ENABLED=false
FUSION_APS_CLIENT_ID=
FUSION_APS_CLIENT_SECRET=
FUSION_APS_REDIRECT_URI=
# Fernet key generated and stored by the operator, not accepted via an API request.
FUSION_TOKEN_ENCRYPTION_KEY=
FUSION_TOKEN_DB_PATH=./data/fusion360/tokens.db

# Direct Fusion Desktop -> HTTPS Cloud Agent. The same configured LLM provider
# is used; no second model credential is required. Prompts and CAD context are
# not persisted in the audit database.
FUSION_AGENT_DB_PATH=./data/fusion360/agent-audit.db
FUSION_AGENT_ARTIFACT_DIR=./data/fusion360/agent-artifacts
FUSION_AGENT_ARTIFACT_MAX_BYTES=67108864
FUSION_AGENT_PLAN_TTL_S=300
# Empty uses LLM_MODEL.
FUSION_AGENT_MODEL=
