# Incremental Tencent release from the previously verified AMD64 runtime.
# Projector and validation updates. verify-images.py MUST check all
# runtime and vendored source bytes against the release manifest before use.
ARG VERIFIED_SANDBOX_IMAGE
FROM ${VERIFIED_SANDBOX_IMAGE}
COPY backend/sandbox/executor_entry.py /opt/cad-agent/executor_entry.py
COPY backend/sandbox/freecad_entry.py /opt/cad-agent/freecad_entry.py
COPY backend/sandbox/step_import_normalization.py /opt/cad-agent/step_import_normalization.py
COPY backend/sandbox/freecad_edge_scope.py /opt/cad-agent/freecad_edge_scope.py
COPY backend/sandbox/capability_entry.py /opt/cad-agent/capability_entry.py
COPY backend/sandbox/freecad_result_channel.py /opt/cad-agent/freecad_result_channel.py
COPY backend/sandbox/freecad_engineering.py /opt/cad-agent/freecad_engineering.py
COPY backend/sandbox/freecad_scene.py /opt/cad-agent/freecad_scene.py
COPY backend/sandbox/freecad_release.py /opt/cad-agent/freecad_release.py
COPY backend/app/freecad/sketch_diagnostics.py /opt/cad-agent/freecad_sketch_diagnostics.py
COPY backend/app/freecad/failure_snapshot.py /opt/cad-agent/freecad_failure_snapshot.py
COPY backend/app/freecad/constraint_relationships.py /opt/cad-agent/freecad_constraint_relationships.py
COPY backend/app/freecad/sketch_relations.py /opt/cad-agent/freecad_sketch_relations.py
COPY backend/sandbox/freecad_constraint_validation.py /opt/cad-agent/freecad_constraint_validation.py
COPY backend/app/freecad/capabilities.json /opt/cad-agent/freecad-capabilities.json
COPY backend/app/freecad/reference_geometry.py /opt/cad-agent/freecad_reference_geometry.py
COPY --chown=1000:1000 backend/app/freecad/state_projector.py /opt/cad-agent/freecad_state_projector.py
COPY backend/sandbox/geometry_validation.py /opt/cad-agent/geometry_validation.py
COPY backend/sandbox/feature_verification.py /opt/cad-agent/feature_verification.py
COPY backend/sandbox/measurement_source.py /opt/cad-agent/measurement_source.py
COPY backend/app/contracts/geometry_request.py /opt/cad-agent/geometry_request.py
COPY backend/app/contracts/acceptance_comparison.py /opt/cad-agent/acceptance_comparison.py
COPY backend/app/contracts/hole_populations.py /opt/cad-agent/hole_populations.py
COPY backend/app/contracts/measurement_binding.py /opt/cad-agent/measurement_binding.py
COPY backend/sandbox/dfm_validation.py /opt/cad-agent/dfm_validation.py
COPY backend/sandbox/mesh_normalization.py /opt/cad-agent/mesh_normalization.py

# Keep the complete source inventory aligned with the standard runtime image.
COPY backend/sandbox/runtime-requirements.txt /opt/cad-agent/runtime-requirements.txt
COPY backend/sandbox/runtime-lock.json /opt/cad-agent/runtime-lock.json
COPY backend/sandbox/patch_build123d.py /opt/cad-agent/patch_build123d.py
COPY backend/sandbox/freecad_cut_diagnostics.py /opt/cad-agent/freecad_cut_diagnostics.py
COPY backend/sandbox/freecad_api.py /opt/cad-agent/freecad_api.py
COPY backend/sandbox/freecad_catalog.py /opt/cad-agent/freecad_catalog.py
COPY backend/sandbox/freecad_bom.py /opt/cad-agent/freecad_bom.py
COPY backend/sandbox/freecad_cam.py /opt/cad-agent/freecad_cam.py
COPY backend/app/freecad/topology.py /opt/cad-agent/freecad_topology.py
COPY backend/app/freecad/native_references.py /opt/cad-agent/freecad_native_references.py
COPY backend/app/contracts/native_references.py /opt/cad-agent/freecad_native_reference_contracts.py
COPY backend/sandbox/material_measurements.py /opt/cad-agent/material_measurements.py
COPY backend/sandbox/rectangular_assembly.py /opt/cad-agent/rectangular_assembly.py
COPY backend/app/contracts/assembly_measurements.py /opt/cad-agent/assembly_measurements.py
COPY backend/sandbox/visual_render.py /opt/cad-agent/visual_render.py
COPY backend/sandbox/dfm_brep.py /opt/cad-agent/dfm_brep.py
COPY backend/sandbox/runtime_probe.py /opt/cad-agent/runtime_probe.py
COPY backend/sandbox/freecad_runtime_probe.py /opt/cad-agent/freecad_runtime_probe.py
