  "$id": "https://cad-agent.local/schemas/fusion360/agent-plan/1.0.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "action": {
      "anyOf": [
        {
          "discriminator": {
            "mapping": {
              "cad.create_chamfer": "#/$defs/CreateChamferAction",
              "cad.create_extrude": "#/$defs/CreateExtrudeAction",
              "cad.create_fillet": "#/$defs/CreateFilletAction",
              "cad.create_hole": "#/$defs/CreateHoleAction",
              "cad.create_sketch": "#/$defs/CreateSketchAction",
              "cad.export": "#/$defs/ExportAction",
              "cad.save_as": "#/$defs/SaveAsAction",
              "cad.save_document": "#/$defs/SaveDocumentAction",
              "cad.update_entity_properties": "#/$defs/UpdateEntityPropertiesAction",
              "cad.update_feature_parameter": "#/$defs/UpdateFeatureParameterAction",
              "cad.update_parameter": "#/$defs/UpdateParameterAction"
            },
            "propertyName": "action"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/UpdateParameterAction"
            },
            {
              "$ref": "#/$defs/UpdateFeatureParameterAction"
            },
            {
              "$ref": "#/$defs/CreateSketchAction"
            },
            {
              "$ref": "#/$defs/CreateExtrudeAction"
            },
            {
              "$ref": "#/$defs/CreateHoleAction"
            },
            {
              "$ref": "#/$defs/CreateFilletAction"
            },
            {
              "$ref": "#/$defs/CreateChamferAction"
            },
            {
              "$ref": "#/$defs/UpdateEntityPropertiesAction"
            },
            {
              "$ref": "#/$defs/SaveDocumentAction"
            },
            {
              "$ref": "#/$defs/SaveAsAction"
            },
            {
              "$ref": "#/$defs/ExportAction"
            }
          ]
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Action"
    },
    "connector_instance_id": {
      "format": "uuid",
      "title": "Connector Instance Id",
      "type": "string"
    },
    "context_fingerprint": {
      "pattern": "^ctx-c14n-1:[0-9a-f]{64}$",
      "title": "Context Fingerprint",
      "type": "string"
    },
    "contract_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Contract Version",
      "type": "string"
    },
    "expires_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Expires At"
    },
    "proposal_id": {
      "format": "uuid",
      "title": "Proposal Id",
      "type": "string"
    },
    "question": {
      "anyOf": [
        {
          "maxLength": 1000,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Question"
    },
    "reason": {
      "anyOf": [
        {
          "maxLength": 2000,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reason"
    },
    "request_id": {
      "format": "uuid",
      "title": "Request Id",
      "type": "string"
    },
    "risk": {
      "anyOf": [
        {
          "enum": [
            "low",
            "medium",
            "high"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Risk"
    },
    "status": {
      "enum": [
        "proposed",
        "needs_clarification",
        "no_action"
      ],
      "title": "Status",
      "type": "string"
    }
  },
  "required": [
    "request_id",
    "proposal_id",
    "connector_instance_id",
    "status",
    "context_fingerprint"
  ],
  "title": "AgentPlanResponse",
  "type": "object",
  "x-contract-version": "1.0.0"
