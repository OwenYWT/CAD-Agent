  "$id": "https://cad-agent.local/schemas/fusion360/agent-turn/1.0.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "capabilities": {
      "$ref": "#/$defs/CadCapabilities"
    },
    "connector_instance_id": {
      "format": "uuid",
      "title": "Connector Instance Id",
      "type": "string"
    },
    "context": {
      "$ref": "#/$defs/ContextData"
    },
    "context_fingerprint": {
      "pattern": "^ctx-c14n-1:[0-9a-f]{64}$",
      "title": "Context Fingerprint",
      "type": "string"
    },
    "contract_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Contract Version",
      "type": "string"
    },
    "export_artifact_upload_consent": {
      "default": false,
      "title": "Export Artifact Upload Consent",
      "type": "boolean"
    },
    "f3d_upload_authorized": {
      "default": false,
      "title": "F3D Upload Authorized",
      "type": "boolean"
    },
    "prompt": {
      "maxLength": 8000,
      "minLength": 1,
      "title": "Prompt",
      "type": "string"
    },
    "request_id": {
      "format": "uuid",
      "title": "Request Id",
      "type": "string"
    }
  },
  "required": [
    "connector_instance_id",
    "prompt",
    "context",
    "context_fingerprint",
    "capabilities"
  ],
  "title": "AgentTurnRequest",
  "type": "object",
  "x-contract-version": "1.0.0"
}
